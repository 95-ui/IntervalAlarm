<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <!-- Titel -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Interval Alarm Multi"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deine Erinnerungen"
        android:textSize="15sp"
        android:textColor="#BBBBBB"
        android:layout_marginBottom="20dp" />

    <!-- Liste der Erinnerungen -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerReminders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <!-- Leerer Zustand -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Noch keine Erinnerungen.\nTippe auf + um eine hinzuzufügen."
        android:textSize="16sp"
        android:textColor="#888888"
        android:visibility="gone" />

    <!-- Buttons unten -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnStartAll"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Alle starten"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"
            app:backgroundTint="#E94560" />

        <!--
          WICHTIG: style muss zur MaterialComponents-Familie des Theme
          passen (siehe themes.xml). Vorher wurde hier fälschlicherweise
          ein Material3-Style auf einem MaterialComponents-Theme verwendet,
          wodurch die Textgröße nicht sauber aufgelöst wurde und winzig
          erschien. Zusätzlich textSize explizit gesetzt, damit es garantiert
          lesbar bleibt.
        -->
        <Button
            android:id="@+id/btnStopAll"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Alle stoppen"
            android:textSize="16sp"
            android:textColor="#E94560"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#E94560"
        app:tint="@android:color/white" />

</LinearLayout>
